+    private void installPortraitSplitLayout(ViewGroup parent) {
+        if (!(parent instanceof RelativeLayout)) {
+            Log.w(TAG, "Portrait split layout requires SDL's RelativeLayout root");
+            return;
+        }
+
+        portraitSplitRoot = (RelativeLayout) parent;
+        portraitSplitRoot.addOnLayoutChangeListener(portraitSplitLayoutListener);
+        applyPortraitSplitLayout();
+    }
+
+    private void applyPortraitSplitLayout() {
+        if (!PORTRAIT_SPLIT_LAYOUT || portraitSplitRoot == null || mSurface == null) {
+            return;
+        }
+
+        InputOverlay overlay = getmOverlay();
+        if (overlay == null) {
+            return;
+        }
+
+        int rootWidth = portraitSplitRoot.getWidth();
+        int rootHeight = portraitSplitRoot.getHeight();
+        if (rootWidth <= 0 || rootHeight <= 1) {
+            return;
+        }
+
+        // Vita's native display is 960x544. Keep the game view at that aspect ratio.
+        int gameHeight = Math.round(rootWidth / VITA_DISPLAY_ASPECT_RATIO);
+        gameHeight = Math.max(1, Math.min(gameHeight, rootHeight - 1));
+        int controlsHeight = rootHeight - gameHeight;
+
+        ViewGroup.LayoutParams surfaceParams = mSurface.getLayoutParams();
+        if (!(surfaceParams instanceof RelativeLayout.LayoutParams)
+                || surfaceParams.width != ViewGroup.LayoutParams.MATCH_PARENT
+                || surfaceParams.height != gameHeight) {
+            RelativeLayout.LayoutParams params = new RelativeLayout.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, gameHeight);
+            params.addRule(RelativeLayout.ALIGN_PARENT_TOP);
+            params.addRule(RelativeLayout.ALIGN_PARENT_LEFT);
+            mSurface.setLayoutParams(params);
+        }
+
+        ViewGroup.LayoutParams overlayParams = overlay.getLayoutParams();
+        if (!(overlayParams instanceof RelativeLayout.LayoutParams)
+                || overlayParams.width != ViewGroup.LayoutParams.MATCH_PARENT
+                || overlayParams.height != controlsHeight) {
+            RelativeLayout.LayoutParams params = new RelativeLayout.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, controlsHeight);
+            params.addRule(RelativeLayout.ALIGN_PARENT_BOTTOM);
+            params.addRule(RelativeLayout.ALIGN_PARENT_LEFT);
+            overlay.setLayoutParams(params);
+        }
+    }
